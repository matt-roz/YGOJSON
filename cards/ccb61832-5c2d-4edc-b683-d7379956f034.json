    "zh-CN": {
      "name": "\u4ee3\u8fbe\u7f57\u65af\u7684\u5927\u6da1",
      "effect": "\u6b64\u5361\u540d\u7684\u2460\u2461\u6548\u679c1\u56de\u54081\u6b21\uff0c\u4ec5\u53ef\u4f7f\u7528\u5176\u4e2d1\u4e2a\u3002\u2460\uff1a\u81ea\u5df1\u573a\u4e0a\u5b58\u5728\u201c\u9f99\u90fd \u4e9a\u7279\u5170\u8482\u65af\u201d\uff0c\u4e14\u5bf9\u624b\u53ec\u5524\u30fb\u7279\u6b8a\u53ec\u5524\u602a\u517d\u4e4b\u9645\u53ef\u4ee5\u53d1\u52a8\u3002\u5c06\u5176\u65e0\u6548\uff0c\u5c06\u8be5\u602a\u517d\u7834\u574f\u3002\u7136\u540e\uff0c\u81ea\u5df1\u573a\u4e0a\u5b58\u5728\u6c34\u5c5e\u6027\u8fde\u63a5\u602a\u517d\u7684\u60c5\u51b5\u4e0b\uff0c\u53ef\u5c06\u9664\u6c34\u5c5e\u6027\u602a\u517d\u4ee5\u5916\u7684\u3001\u573a\u4e0a\u7684\u602a\u517d\u5168\u90e8\u7834\u574f\u3002\u2461\uff1a\u5c06\u5893\u5730\u7684\u6b64\u5361\u9664\u5916\uff0c\u5c06\u81ea\u5df1\u573a\u4e0a\u76841\u5f20\u8868\u4fa7\u8868\u793a\u7684\u201c\u6d77\u201d\u9001\u81f3\u5893\u5730\uff0c\u4ee5\u5bf9\u624b\u573a\u4e0a\u76841\u53ea\u602a\u517d\u4e3a\u5bf9\u8c61\u53ef\u4ee5\u53d1\u52a8\u3002\u5c06\u8be5\u602a\u517d\u9001\u81f3\u5893\u5730\u3002"
