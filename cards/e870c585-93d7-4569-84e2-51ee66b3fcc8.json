    },
    "ko": {
      "name": "\uc18c\uc2e0\uac15\ub9bc",
      "effect": "\uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ub808\ubca8 7 \uc774\uc0c1 / \ucc9c\uc0ac\uc871) 1\uc7a5\uc744 \uace0\ub974\uace0, \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud55c\ub2e4. \uc774 \ud6a8\uacfc\ub85c \"\uc18c\ud48d\uc758 \uc544\uc790\ub808\uc2a4\" \uc774\uc678\uc758 \ubaac\uc2a4\ud130\ub97c \ud2b9\uc218 \uc18c\ud658\ud588\uc744 \uacbd\uc6b0, \ucd94\uac00\ub85c \uc790\uc2e0\uc740 \ud328\uc758 \ubaac\uc2a4\ud130 2\uc7a5\uc744 \uace0\ub974\uace0 \ubb18\uc9c0\ub85c \ubcf4\ub0b8\ub2e4."
