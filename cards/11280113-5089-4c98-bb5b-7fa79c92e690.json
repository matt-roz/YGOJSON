  "text": {
    "en": {
      "name": "The Trinity Dragiastar",
      "effect": "\u25cfThis turn, this card can make up to 3 attacks. \u25cfShuffle up to 3 Normal Monsters from your Graveyard into the Deck. Then, you can destroy Spell/Trap Cards on your opponent's field, up to [the number of \"The Dragias\" shuffled by this effect].",
      "official": false
    },
    "ja": {
      "name": "\u30b6\u2606\u30c8\u30ea\u30cb\u30c6\u30a3\u30fb\u30c9\u30e9\u30ae\u30a2\u30b9\u30bf\u30fc",
      "effect": "\u25cf\u3053\u306e\u30bf\u30fc\u30f3\u3001\u3053\u306e\u30ab\u30fc\u30c9\u306f\uff13\u56de\u653b\u6483\u3067\u304d\u308b\u3002\u25cf\u81ea\u5206\u306e\u5893\u5730\u306e\u901a\u5e38\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\uff13\u4f53\u307e\u3067\u9078\u3093\u3067\u30c7\u30c3\u30ad\u306b\u623b\u3059\u3002\u305d\u306e\u5f8c\u3001\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u9b54\u6cd5\u30fb\u7f60\u30ab\u30fc\u30c9\u3092\uff3b\u3053\u306e\u52b9\u679c\u3067\u623b\u3057\u305f\u300c\u30b6\u2606\u30c9\u30e9\u30ae\u30a2\u30b9\u300d\u306e\u6570\uff3d\u307e\u3067\u9078\u3093\u3067\u7834\u58ca\u3067\u304d\u308b\u3002"
    },
    "ko": {
      "name": "\ub354\u2606\ud2b8\ub9ac\ub2c8\ud2f0 \ub4dc\ub77c\uae30\uc544\uc2a4\ud0c0",
      "effect": "\u25cf\uc774 \ud134\uc5d0, \uc774 \uce74\ub4dc\ub294 3\ud68c \uacf5\uaca9\ud560 \uc218 \uc788\ub2e4. \u25cf\uc790\uc2e0 \ubb18\uc9c0\uc758 \uc77c\ubc18 \ubaac\uc2a4\ud130\ub97c 3\uc7a5\uae4c\uc9c0 \uace0\ub974\uace0 \ub371\uc73c\ub85c \ub418\ub3cc\ub9b0\ub2e4. \uadf8 \ud6c4, \uc0c1\ub300 \ud544\ub4dc\uc758 \ub9c8\ubc95 / \ud568\uc815 \uce74\ub4dc\ub97c [\uc774 \ud6a8\uacfc\ub85c \ub418\ub3cc\ub9b0 \"\ub354\u2606\ub4dc\ub77c\uae30\uc544\uc2a4\"\uc758 \uc218]\uae4c\uc9c0 \uace0\ub974\uace0 \ud30c\uad34\ud560 \uc218 \uc788\ub2e4."
    }
