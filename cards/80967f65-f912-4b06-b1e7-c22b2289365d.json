    "en": {
      "name": "Skysavior Watch",
      "effect": "Excavate the top 5 cards of your Deck. Add 1 excavated card to your hand. Then, place the remaining cards on the bottom of your Deck in any order. This turn, your Level 8 or lower monsters cannot attack, and your opponent takes no effect damage."
    },
    "ja": {
      "name": "\u84bc\u6551\u306e\u7167\u89a7",
      "effect": "\u81ea\u5206\u306e\u30c7\u30c3\u30ad\u306e\u4e0a\u304b\u3089\u30ab\u30fc\u30c9\u3092\uff15\u679a\u3081\u304f\u308a\u3001\u304a\u4e92\u3044\u306b\u78ba\u8a8d\u3059\u308b\u3002\u81ea\u5206\u306f\u305d\u306e\u4e2d\u304b\u3089\uff11\u679a\u3092\u9078\u3093\u3067\u624b\u672d\u306b\u52a0\u3048\u308b\u3002\u6b8b\u308a\u306e\u30ab\u30fc\u30c9\u3092\u597d\u304d\u306a\u9806\u756a\u3067\u30c7\u30c3\u30ad\u306e\u4e0b\u306b\u623b\u3059\u3002\u3053\u306e\u52b9\u679c\u306e\u767a\u52d5\u5f8c\u30bf\u30fc\u30f3\u7d42\u4e86\u6642\u307e\u3067\u3001\u81ea\u5206\u306f\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff18\u4ee5\u4e0b\uff09\u3067\u653b\u6483\u3067\u304d\u305a\u3001\u76f8\u624b\u306f\u52b9\u679c\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u306a\u3044\u3002"
    },
    "ko": {
      "name": "\ucc3d\uad6c\uc758 \uc870\ub78c",
      "effect": "\uc790\uc2e0\uc758 \ub371 \uc704\uc5d0\uc11c \uce74\ub4dc\ub97c 5\uc7a5 \ub118\uae30\uace0, \uc11c\ub85c \ud655\uc778\ud55c\ub2e4. \uc790\uc2e0\uc740 \uadf8 \uc911\uc5d0\uc11c 1\uc7a5\uc744 \uace0\ub974\uace0 \ud328\uc5d0 \ub123\ub294\ub2e4. \ub0a8\uc740 \uce74\ub4dc\ub97c \uc88b\uc544\ud558\ub294 \uc21c\uc11c\ub300\ub85c \ub371 \uc544\ub798\ub85c \ub418\ub3cc\ub9b0\ub2e4. \uc774 \ud6a8\uacfc\uc758 \ubc1c\ub3d9 \ud6c4 \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0, \uc790\uc2e0\uc740 \ubaac\uc2a4\ud130(\ub808\ubca8 8 \uc774\ud558)\ub85c \uacf5\uaca9\ud560 \uc218 \uc5c6\uc73c\uba70, \uc0c1\ub300\ub294 \ud6a8\uacfc \ub370\ubbf8\uc9c0\ub97c \ubc1b\uc9c0 \uc54a\ub294\ub2e4."
    }
