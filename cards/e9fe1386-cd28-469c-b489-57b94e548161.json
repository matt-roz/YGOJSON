    "en": {
      "name": "Rainbow-Eyes Star Cat",
      "effect": "Send cards from the top of your Deck to the Graveyard equal to [the number of face-up Level 7 or higher monsters on the field]. Then, if a monster(s) is among the cards sent, you can add up to 2 Level 7 monsters with 200 DEF from your Graveyard to your hand.",
      "official": false
    },
