    },
    "ko": {
      "name": "P\u00b7M \ud50c\ub808\uc774",
      "effect": "\ub808\ubca8\uc758 \ud569\uacc4\uac00 8 \uc774\uc0c1\uc774 \ub418\ub3c4\ub85d, \uc790\uc2e0 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130(\ubc88\uac1c\uc871)\ub97c \uc18c\uc7ac\ub85c\uc11c \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uace0, \"P\u00b7MR(\ud50c\ub77c\uc988\ub9c8\ud2f1\ubaa8\ub378 \ub77c\uc774\uc9d5)\uff0d\ub9ac\uc2a4\ud154\ub77c\" \ub610\ub294 \"P\u00b7MR(\ud50c\ub77c\uc988\ub9c8\ud2f1\ubaa8\ub378 \ub77c\uc774\uc9d5)\uff0d\ube0c\ub77c\uc6b0\"\ub97c \ub9ac\ucd94\uc5bc \uc18c\ud658\ud55c\ub2e4(\uc5ec\ubd84\uc758 \ubaac\uc2a4\ud130\ub97c \uc18c\uc7ac\ub85c \ud560 \uc218 \uc5c6\ub2e4). \uc774 \ud134\uc5d0, \uc790\uc2e0\uc740 \ubaac\uc2a4\ud130(\ubc88\uac1c\uc871 \uc774\uc678)\ub85c \uacf5\uaca9\ud560 \uc218 \uc5c6\ub2e4."
