  "text": {
    "en": {
      "name": "Straynge Cat",
      "effect": "A familiar said to hold great powers. It doesn't like being alone, and is very lonely now that it's been separated from its friends."
    },
    "fr": {
      "name": "Chat Errange",
      "effect": "On dit que ce familier d\u00e9tient de grands pouvoirs. Il n'aime pas \u00eatre seul, et se sent tr\u00e8s triste apr\u00e8s avoir \u00e9t\u00e9 s\u00e9par\u00e9 de ses amis."
    },
    "de": {
      "name": "Seltsamer Streuner",
      "effect": "Ein Vertrauter, von dem man sagt, dass er \u00fcber gro\u00dfe Macht verf\u00fcgt. Er ist nicht gern allein, und jetzt, da er von seinen Freunden getrennt ist, ist er sehr einsam."
    },
    "it": {
      "name": "Gatto Strandagio",
      "effect": "Si dice che questo famiglio abbia grandi poteri. Non gli piace stare da solo, ed \u00e8 molto triste ora che \u00e8 stato separato dai suoi amici."
    },
    "es": {
      "name": "Gata Extra\u00f1ojera",
      "effect": "Un familiar que debe tener grandes poderes. No le gusta estar solo, y siente soledad ahora que se ha separado de sus amigos."
    },
