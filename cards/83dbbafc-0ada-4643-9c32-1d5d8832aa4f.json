    "ko": {
      "name": "\ubcf4\uc774\ub4dc\ubca0\ub974\uadf8 \ud654\uc774\ud2b8\ub77c\uc774\ub354",
      "effect": "\uc774 \uce74\ub4dc\uc758 \uce74\ub4dc\uba85\uc740 \uc774 \ud134\uc5d0, \"\ubcf4\uc774\ub4dc\ubca0\ub974\uadf8 \ud398\uc77c\ub77c\uc774\ub354\"\uac00 \ub41c\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0\uc758 \ub371 \uc704\uc5d0\uc11c \uce74\ub4dc\ub97c 3\uc7a5 \ub118\uae30\uace0, \uc11c\ub85c \ud655\uc778\ud55c\ub2e4. \uc790\uc2e0\uc740 \uadf8 \uc911\uc5d0\uc11c \"\ubcf4\uc774\ub4dc\ubca0\ub974\uadf8 \ub808\ud034\uc5e0\" \ub610\ub294 \uc77c\ubc18 \ubaac\uc2a4\ud130(\uc5b4\ub460 \uc18d\uc131 / \uac24\ub7ed\uc2dc\uc871) 1\uc7a5\uc744 \uace0\ub974\uace0 \ud328\uc5d0 \ub123\uc744 \uc218 \uc788\ub2e4. \ub0a8\uc740 \uce74\ub4dc\ub97c \uc88b\uc544\ud558\ub294 \uc21c\uc11c\ub300\ub85c \ub371 \uc544\ub798\ub85c \ub418\ub3cc\ub9b0\ub2e4."
