  "text": {
    "en": {
      "name": "Mind Master",
      "effect": "You can pay 800 Life Points and Tribute 1 Psychic-Type monster, except \"Mind Master\", to Special Summon 1 Level 4 or lower Psychic-Type monster from your Deck in face-up Attack Position."
    },
    "fr": {
      "name": "Ma\u00eetre \u00e0 Penser",
      "effect": "Vous pouvez payer 800 Life Points et Sacrifier 1 monstre de Type Psychique, except\u00e9 \"Ma\u00eetre \u00e0 Penser\", pour Invoquer Sp\u00e9cialement depuis votre Deck, 1 monstre de Type Psychique de Niveau 4 ou moins en Position d'Attaque face recto."
    },
    "de": {
      "name": "Meister der Gedanken",
      "effect": "Du kannst 800 Life Points zahlen und 1 Monster vom Typ Psi au\u00dfer \u201eMeister der Gedanken\u201c als Tribut anbieten, um 1 Monster der Stufe 4 oder niedriger vom Typ Psi als Spezialbeschw\u00f6rung von deinem Deck in die offene Angriffsposition zu beschw\u00f6ren."
    },
    "it": {
      "name": "Maestro della Mente",
      "effect": "Puoi pagare 800 Life Points e offrire come Tributo 1 mostro di Tipo Psichico, eccetto \"Maestro della Mente\", per Evocare tramite Evocazione Speciale 1 mostro di Tipo Psichico di Livello 4 o inferiore dal tuo Deck, scoperto in Posizione di Attacco."
    },
    "es": {
      "name": "Amo de las Mentes",
      "effect": "Puedes pagar 800 Life Points y Sacrificar 1 monstruo de Tipo Ps\u00edquico (excepto \"Amo de las Mentes\") para Invocar de Modo Especial desde tu Deck 1 monstruo de Tipo Ps\u00edquico de Nivel 4 o menor en Posici\u00f3n de Ataque boca arriba."
    },
