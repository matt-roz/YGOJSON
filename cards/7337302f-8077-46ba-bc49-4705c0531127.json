  "text": {
    "en": {
      "name": "Perfect Eclosion - Perfectly Ultimate Great Moth",
      "effect": "Cannot be Normal Summoned/Set. Must be Special Summoned (from your hand) by having 6 or more Insect monsters in your GY. You can only Special Summon \"Perfect Eclosion - Perfectly Ultimate Great Moth\" once per turn this way. If this card is Special Summoned: You can return as many cards your opponent controls as possible to the hand, then if you have a Normal Monster in your GY, you can make this card gain 300 ATK for each Insect monster in your GY. Each time your opponent Normal or Special Summons a monster(s): All monsters your opponent currently controls lose ATK equal to their own Level x 100.",
      "official": false
    },
    "ja": {
