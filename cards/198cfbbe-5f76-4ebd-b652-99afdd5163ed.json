    "ko": {
      "name": "\uac24\ub7ed\ud2f0\uce74 \ub808\ubbf8\ub2c8\uc13c\uc2a4",
      "effect": "\uc790\uc2e0 \ud544\ub4dc\uc758 \ubaa8\ub4e0 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130(\uac24\ub7ed\uc2dc\uc871)\uc758 \uacf5\uaca9\ub825\uc744 \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0 400 \uc62c\ub9b0\ub2e4. \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\uc758 \"\uac24\ub7ed\ud2f0\uce74 \uc624\ube14\ub9ac\ube44\uc5b8\"\uc774 \uc788\uc744 \uacbd\uc6b0, \ucd94\uac00\ub85c \uc0c1\ub300 \ud544\ub4dc\uc758 \ubaa8\ub4e0 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130\uc758 \uacf5\uaca9\ub825\uc744 \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0 1000 \ub0b4\ub9b4 \uc218 \uc788\ub2e4."
