  "text": {
    "en": {
      "name": "Sevens Chariot",
      "effect": "\u25cfThis card gains ATK equal to [the number of cards in the Spell & Trap Zones] x 500 until the end of this turn. \u25cfThis turn, this card cannot be destroyed by your opponent's card effects. You can also destroy face-up cards on your opponent's field up to [the number of cards in your Spell & Trap Zone]."
    },
    "ja": {
      "name": "\u9b54\u5c0e\u9a0e\u58eb\uff0d\u30bb\u30d6\u30f3\u30b9\u30fb\u30c1\u30e3\u30ea\u30aa\u30c3\u30c8",
      "effect": "\u25cf\u3053\u306e\u30ab\u30fc\u30c9\u306e\u653b\u6483\u529b\u306f\u30bf\u30fc\u30f3\u7d42\u4e86\u6642\u307e\u3067\u3001\uff3b\u304a\u4e92\u3044\u306e\u9b54\u6cd5\uff06\u7f60\u30be\u30fc\u30f3\u306e\u30ab\u30fc\u30c9\u306e\u6570\uff3d\u00d7\uff15\uff10\uff10\u30a2\u30c3\u30d7\u3059\u308b\u3002\u25cf\u3053\u306e\u30bf\u30fc\u30f3\u3001\u3053\u306e\u30ab\u30fc\u30c9\u306f\u76f8\u624b\u306e\u52b9\u679c\u3067\u306f\u7834\u58ca\u3055\u308c\u306a\u3044\u3002\u3055\u3089\u306b\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u8868\u5074\u8868\u793a\u306e\u30ab\u30fc\u30c9\u3092\uff3b\u81ea\u5206\u306e\u9b54\u6cd5\uff06\u7f60\u30be\u30fc\u30f3\u306e\u30ab\u30fc\u30c9\u306e\u6570\uff3d\u307e\u3067\u9078\u3093\u3067\u7834\u58ca\u3067\u304d\u308b\u3002"
    },
    "ko": {
      "name": "\ub9c8\ub3c4 \uae30\uc0ac\uff0d\uc138\ube10\uc988 \ucc44\ub9ac\uc5b4\ud2b8",
      "effect": "\u25cf\uc774 \uce74\ub4dc\uc758 \uacf5\uaca9\ub825\uc740 \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0, [\uc11c\ub85c\uc758 \ub9c8\ubc95 & \ud568\uc815 \uc874\uc758 \uce74\ub4dc\uc758 \uc218] \u00d7 500 \uc62c\ub9b0\ub2e4. \u25cf\uc774 \ud134\uc5d0, \uc774 \uce74\ub4dc\ub294 \uc0c1\ub300\uc758 \ud6a8\uacfc\ub85c\ub294 \ud30c\uad34\ub418\uc9c0 \uc54a\ub294\ub2e4. \ucd94\uac00\ub85c \uc0c1\ub300 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc\uc758 \uce74\ub4dc\ub97c [\uc790\uc2e0\uc758 \ub9c8\ubc95 & \ud568\uc815 \uc874\uc758 \uce74\ub4dc\uc758 \uc218]\uae4c\uc9c0 \uace0\ub974\uace0 \ud30c\uad34\ud560 \uc218 \uc788\ub2e4."
    }
