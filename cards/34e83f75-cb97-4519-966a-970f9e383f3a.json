    },
    "ko": {
      "name": "\uc0ac\uc774\ubc84 \ub7ec\uc2dc \ud4e8\uc804",
      "effect": "\uc790\uc2e0\uc758 \ud544\ub4dc / \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ube5b \uc18d\uc131 / \uae30\uacc4\uc871)\ub97c 5\uc7a5\uae4c\uc9c0 \uc18c\uc7ac\ub85c\uc11c \uc8fc\uc778\uc758 \ub371\uc73c\ub85c \ub418\ub3cc\ub9ac\uace0, \"\uc0ac\uc774\ubc84 \ub4dc\ub798\uace4\"\uc758 \uce74\ub4dc\uba85\uc774 \uc18c\uc7ac\ub85c\uc11c \uc4f0\uc5ec\uc9c4 \ubaac\uc2a4\ud130\ub97c \ud4e8\uc804 \uc18c\ud658\ud55c\ub2e4. \uadf8 \ud6c4, \uc774 \ud6a8\uacfc\ub85c \ud2b9\uc218 \uc18c\ud658\ud55c \ubaac\uc2a4\ud130 \uc774\uc678\uc758 \ubaac\uc2a4\ud130\uac00 \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc788\uc744 \uacbd\uc6b0, \uadf8 \ubaac\uc2a4\ud130\ub4e4\uc744 \uc804\ubd80 \ud30c\uad34\ud55c\ub2e4."
