    },
    "ko": {
      "name": "\ud558\ub298\uc758 \uacc4\uc2dc",
      "effect": "\uc790\uc2e0 \ud544\ub4dc\uc758 \ubaac\uc2a4\ud130\ub97c \uc88b\uc544\ud558\ub294 \uc218\ub9cc\ud07c \uace0\ub974\uace0 \ubb18\uc9c0\ub85c \ubcf4\ub0b8\ub2e4. [\uc774 \ud6a8\uacfc\ub85c \ubb18\uc9c0\ub85c \ubcf4\ub0b8 \ubaac\uc2a4\ud130\uc758 \uc6d0\ub798 \ub808\ubca8\uc758 \ud569\uacc4]\uac00 10 \uc774\uc0c1\uc77c \uacbd\uc6b0, \ucd94\uac00\ub85c \uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ub808\ubca8 8 \uc774\ud558) 1\uc7a5\uc744 \uace8\ub77c \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4. \uc774 \ud6a8\uacfc\ub85c \ud2b9\uc218 \uc18c\ud658\ud55c \ubaac\uc2a4\ud130\uc758 \uacf5\uaca9\ub825\uc740 \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0 300 \uc62c\ub9b0\ub2e4."
