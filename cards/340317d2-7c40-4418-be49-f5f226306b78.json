    },
    "ko": {
      "name": "\ub354\u2606\ub4dc\ub77c\ucf54",
      "effect": "\u3010\uc870\uac74\u3011\uc774 \uce74\ub4dc\ub97c \uc77c\ubc18 \uc18c\ud658\ud55c \ud134\uc5d0, \ud328 1\uc7a5\uc744 \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.\n\u3010\ud6a8\uacfc\u3011\uc774 \uce74\ub4dc\uc758 \uce74\ub4dc\uba85\uc740 \uc774 \ud134\uc5d0, \"\ub354\u2606\ub4dc\ub798\uace4\"\uc774 \ub41c\ub2e4. \uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130\uac00 \ud558\uc774\ub4dc\ub798\uace4\uc871 / \ub4dc\ub798\uace4\uc871\ubfd0\uc77c \uacbd\uc6b0, \ucd94\uac00\ub85c \uc790\uc2e0\uc758 \ud328 / \ud544\ub4dc\uc758 \ubaac\uc2a4\ud130\ub97c \uc18c\uc7ac\ub85c\uc11c \uc8fc\uc778\uc758 \ub371\uc73c\ub85c \ub418\ub3cc\ub9ac\uace0 \ubaac\uc2a4\ud130(\ud558\uc774\ub4dc\ub798\uace4\uc871 / \uc218\ube44\ub825 2000)\ub97c \ud4e8\uc804 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4."
