    "ko": {
      "name": "\ud2b8\ub79c\uc7a0 \uc2a4\ud034\ub77c\uc774\ub4dc",
      "effect": "\uc790\uc2e0\uc758 \ub371 \ub9e8 \uc704\uc758 \uce74\ub4dc\ub97c \ubb18\uc9c0\ub85c \ubcf4\ub0b8\ub2e4. \uc774 \ud6a8\uacfc\ub85c \ubaac\uc2a4\ud130(\ube5b \uc18d\uc131 / \uac24\ub7ed\uc2dc\uc871)\uac00 \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uc84c\uc744 \uacbd\uc6b0, \uc790\uc2e0 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130\ub97c 3\uc7a5\uae4c\uc9c0 \uace0\ub97c \uc218 \uc788\ub2e4. \uace0\ub978 \uacbd\uc6b0, \uc774 \ud134\uc5d0, \uace0\ub978 \ubaac\uc2a4\ud130\uc758 \uacf5\uaca9\uc740 \uad00\ud1b5\ud55c\ub2e4. \uc774 \ud6a8\uacfc\ub85c \"\ud2b8\ub79c\uc7a0 \ub77c\uc774\ub098\ud06c\"\ub97c \uace0\ub978 \uacbd\uc6b0, \ucd94\uac00\ub85c \uc0c1\ub300 \ud544\ub4dc\uc758 \uacf5\uaca9 \ud45c\uc2dc \ubaac\uc2a4\ud130\ub97c \uc804\ubd80 \uc55e\uba74 \uc218\ube44 \ud45c\uc2dc\ub85c \ud560 \uc218 \uc788\ub2e4."
