  "$schema": "https://raw.githubusercontent.com/matt-roz/YGOJSON/main/schema/v1/card.json",
  "id": "65b3a6b4-0584-4e5c-8437-28d9251c4a2e",
  "text": {
    "en": {
      "name": "Witchcrafter Terracottan",
      "effect": "If this card is in your hand: You can target 1 \"Witchcrafter\" card in your GY, except \"Witchcrafter Terracottan\"; add it to your hand, and if you do, Special Summon this card, also you cannot Special Summon from the Extra Deck for the rest of this turn, except \"Witchcrafter\" monsters. During your Main Phase: You can Fusion Summon 1 \"Witchcrafter\" Fusion Monster from your Extra Deck, using monsters from your hand or field. You can only use each effect of \"Witchcrafter Terracottan\" once per turn.",
      "official": false
    },
    "ja": {
      "name": "\u30a6\u30a3\u30c3\u30c1\u30af\u30e9\u30d5\u30c8\u30fb\u30c6\u30e9\u30b3\u30c3\u30bf\u30f3",
      "effect": "\u3053\u306e\u30ab\u30fc\u30c9\u540d\u306e\u2460\u2461\u306e\u52b9\u679c\u306f\u305d\u308c\u305e\u308c\uff11\u30bf\u30fc\u30f3\u306b\uff11\u5ea6\u3057\u304b\u4f7f\u7528\u3067\u304d\u306a\u3044\u3002\u2460\uff1a\u3053\u306e\u30ab\u30fc\u30c9\u304c\u624b\u672d\u306b\u5b58\u5728\u3059\u308b\u5834\u5408\u3001\u300c\u30a6\u30a3\u30c3\u30c1\u30af\u30e9\u30d5\u30c8\u30fb\u30c6\u30e9\u30b3\u30c3\u30bf\u30f3\u300d\u4ee5\u5916\u306e\u81ea\u5206\u306e\u5893\u5730\u306e\u300c\u30a6\u30a3\u30c3\u30c1\u30af\u30e9\u30d5\u30c8\u300d\u30ab\u30fc\u30c9\uff11\u679a\u3092\u5bfe\u8c61\u3068\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002\u305d\u306e\u30ab\u30fc\u30c9\u3092\u624b\u672d\u306b\u52a0\u3048\u3001\u3053\u306e\u30ab\u30fc\u30c9\u3092\u7279\u6b8a\u53ec\u559a\u3059\u308b\u3002\u3053\u306e\u30bf\u30fc\u30f3\u3001\u81ea\u5206\u306f\u300c\u30a6\u30a3\u30c3\u30c1\u30af\u30e9\u30d5\u30c8\u300d\u30e2\u30f3\u30b9\u30bf\u30fc\u3057\u304b\uff25\uff38\u30c7\u30c3\u30ad\u304b\u3089\u7279\u6b8a\u53ec\u559a\u3067\u304d\u306a\u3044\u3002\u2461\uff1a\u81ea\u5206\u30e1\u30a4\u30f3\u30d5\u30a7\u30a4\u30ba\u306b\u767a\u52d5\u3067\u304d\u308b\u3002\u81ea\u5206\u306e\u624b\u672d\u30fb\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u878d\u5408\u7d20\u6750\u3068\u3057\u3001\u300c\u30a6\u30a3\u30c3\u30c1\u30af\u30e9\u30d5\u30c8\u300d\u878d\u5408\u30e2\u30f3\u30b9\u30bf\u30fc\uff11\u4f53\u3092\u878d\u5408\u53ec\u559a\u3059\u308b\u3002"
    },
    "ko": {
      "name": "\uc704\uce58\ud06c\ub798\ud504\ud2b8 \ud14c\ub77c\ucf54\ud0c4",
      "effect": "\uc774 \uce74\ub4dc\uba85\uc758 \u2460\u2461\uc758 \ud6a8\uacfc\ub294 \uac01\uac01 1\ud134\uc5d0 1\ubc88\ubc16\uc5d0 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub2e4. \u2460: \uc774 \uce74\ub4dc\uac00 \ud328\uc5d0 \uc874\uc7ac\ud560 \uacbd\uc6b0, \"\uc704\uce58\ud06c\ub798\ud504\ud2b8 \ud14c\ub77c\ucf54\ud0c4\" \uc774\uc678\uc758 \uc790\uc2e0 \ubb18\uc9c0\uc758 \"\uc704\uce58\ud06c\ub798\ud504\ud2b8\" \uce74\ub4dc 1\uc7a5\uc744 \ub300\uc0c1\uc73c\ub85c \ud558\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4. \uadf8 \uce74\ub4dc\ub97c \ud328\uc5d0 \ub123\uace0, \uc774 \uce74\ub4dc\ub97c \ud2b9\uc218 \uc18c\ud658\ud55c\ub2e4. \uc774 \ud134\uc5d0, \uc790\uc2e0\uc740 \"\uc704\uce58\ud06c\ub798\ud504\ud2b8\" \ubaac\uc2a4\ud130\ubc16\uc5d0 \uc5d1\uc2a4\ud2b8\ub77c \ub371\uc5d0\uc11c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc5c6\ub2e4. \u2461: \uc790\uc2e0 \uba54\uc778 \ud398\uc774\uc988\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4. \uc790\uc2e0\uc758 \ud328 / \ud544\ub4dc\uc758 \ubaac\uc2a4\ud130\ub97c \uc735\ud569 \uc18c\uc7ac\ub85c \ud558\uace0, \"\uc704\uce58\ud06c\ub798\ud504\ud2b8\" \uc735\ud569 \ubaac\uc2a4\ud130 1\uc7a5\uc744 \uc735\ud569 \uc18c\ud658\ud55c\ub2e4."
    },
    "zh-CN": {
      "name": "\u9b54\u5973\u5de5\u827a\u30fb\u9676\u4fd1\u9b54\u50cf",
      "effect": "\u6b64\u5361\u540d\u7684\u2460\u2461\u6548\u679c1\u56de\u5408\u4ec5\u53ef\u5404\u4f7f\u75281\u6b21\u3002\u2460\uff1a\u6b64\u5361\u5b58\u5728\u4e8e\u624b\u724c\u7684\u60c5\u51b5\u4e0b\uff0c\u4ee5\u201c\u9b54\u5973\u5de5\u827a\u30fb\u9676\u4fd1\u9b54\u50cf\u201d\u4ee5\u5916\u7684\u3001\u81ea\u5df1\u5893\u5730\u76841\u5f20\u201c\u9b54\u5973\u5de5\u827a\u201d\u5361\u4e3a\u5bf9\u8c61\u53ef\u4ee5\u53d1\u52a8\u3002\u5c06\u8be5\u5361\u52a0\u5165\u624b\u724c\uff0c\u5c06\u6b64\u5361\u7279\u6b8a\u53ec\u5524\u3002\u6b64\u56de\u5408\uff0c\u81ea\u5df1\u4ece\u989d\u5916\u724c\u7ec4\u4ec5\u53ef\u7279\u6b8a\u53ec\u5524\u201c\u9b54\u5973\u5de5\u827a\u201d\u602a\u517d\u3002\u2461\uff1a\u5728\u81ea\u5df1\u7684\u4e3b\u8981\u9636\u6bb5\u53ef\u4ee5\u53d1\u52a8\u3002\u5c06\u81ea\u5df1\u624b\u724c\u30fb\u573a\u4e0a\u7684\u602a\u517d\u4f5c\u4e3a\u878d\u5408\u7d20\u6750\uff0c\u5c061\u53ea\u201c\u9b54\u5973\u5de5\u827a\u201d\u878d\u5408\u602a\u517d\u878d\u5408\u53ec\u5524\u3002"
    }
  },
