    "en": {
      "name": "Blue-Eyes Ultimate Dragon, the God-Surpassing Servant",
      "effect": "\"Blue-Eyes White Dragon\" + \"Blue-Eyes White Dragon\" + \"Blue-Eyes White Dragon\"\nCannot be destroyed by card effects, also unaffected by your opponent's activated effects during your opponent's turn. Can make up to 3 attacks during each Battle Phase. Once per Chain, during the Battle Phase (Quick Effect): You can target 1 monster that was Special Summoned this turn, or 1 face-down card, that your opponent controls; destroy it. You can only use this effect of \"Blue-Eyes Ultimate Dragon, the God-Surpassing Servant\" thrice per turn.",
      "official": false
    },
    "ja": {
      "name": "\u795e\u3092\u8d85\u3048\u305f\u3057\u3082\u3079\uff0d\u9752\u773c\u306e\u7a76\u6975\u7adc",
